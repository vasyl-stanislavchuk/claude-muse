{
  "theme": "dark",
  "statusLine": {
    "type": "command",
    "command": "__PROFILE_DIR__/statusline.sh",
    "padding": 0
  },
  "tui": "fullscreen",
  "apiKeyHelper": "__STATE_DIR__/api-key.sh",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Agent",
      "Task",
      "TaskList",
      "TaskStop",
      "Skill",
      "CronCreate",
      "CronDelete",
      "ScheduleWakeup",
      "Monitor",
      "WebSearch",
      "WebFetch",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tree:*)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(make:*)",
      "Bash(md:*)",
      "Bash(bd:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(uv pip install:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(pre-commit run:*)",
      "Bash(pytest:*)",
      "Bash(python -c:*)",
      "Bash(python3 -c:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git worktree:*)",
      "Bash(git rebase:*)",
      "Bash(git cat-file:*)",
      "Bash(gh api:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr review:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(docker compose:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__PROFILE_DIR__/hooks/continue-gate",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
