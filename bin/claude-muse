#!/usr/bin/env bash
# claude-muse as an executable: Claude Code's interface, running Meta's muse-spark-1.3.
#
# The shell function forwards here, and so does anything that launches sessions without a shell
# function in reach: md, Switchboard, a cmux tab typed into by a script. `env` can only start a
# program, which is why this exists as a file rather than only as a function in ~/.zshrc.
#
# Identity comes from model-env.sh and every check from preflight.sh, both read fresh from the
# install on each launch, so this file changes as rarely as the function it replaced. No `set -u`:
# preflight.sh is written for the function's plain shell, and runs the same way here.

MUSE_STATE_DIR="$HOME/.config/claude-muse"

# shellcheck source=../lib/model-env.sh
source "$MUSE_STATE_DIR/model-env.sh" || {
  printf 'claude-muse: %s/model-env.sh is missing. Run install.sh.\n' "$MUSE_STATE_DIR" >&2
  exit 1
}

export ENABLE_TOOL_SEARCH="true"
export CLAUDE_CODE_EFFORT_LEVEL="max"

# shellcheck source=../lib/preflight.sh
source "$MUSE_STATE_DIR/preflight.sh" || exit 1

exec claude "$@"
